#include <cstdint>
#include <string>

namespace uvgvpccdec {

std::string get_version() { return "@uvgVPCCdec_VERSION@"; }

uint16_t get_version_major() { return @uvgVPCCdec_VERSION_MAJOR@; }

uint16_t get_version_minor() { return @uvgVPCCdec_VERSION_MINOR@; }

uint16_t get_version_patch() { return @uvgVPCCdec_VERSION_PATCH@; }

// std::string get_git_hash() {return "@uvgVPCCdec_GIT_HASH@";}
} // namespace uvgvpccdec